<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@(ViewBag.Title ?? "InvoiceWise")</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <strong>InvoiceWise</strong>
        <nav>
            <a href="/Invoices/Index">My Invoices</a> |
            <a href="/Invoices/Search">Find Invoice</a> |
